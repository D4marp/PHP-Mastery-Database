            {
              "name": "nim",
              "type": "VARCHAR(255)",
              "constraint": "UNIQUE, NOT NULL",
              "description": "Nomor Identitas Mahasiswa"
            },
            {
              "name": "name",
              "type": "VARCHAR(255)",
              "constraint": "NOT NULL",
              "description": "Nama lengkap"
            },
            {
              "name": "email",
              "type": "VARCHAR(255)",
              "constraint": "UNIQUE, NOT NULL",
              "description": "Email mahasiswa"
            },
            {
              "name": "phone",
              "type": "VARCHAR(255)",
              "constraint": "NOT NULL",
              "description": "Nomor telepon"
            },
            {
              "name": "address",
              "type": "TEXT",
              "constraint": "NOT NULL",
              "description": "Alamat lengkap"
            },
            {
              "name": "major",
              "type": "VARCHAR(255)",
              "constraint": "NOT NULL",
              "description": "Program studi"
            },
            {
              "name": "created_at",
              "type": "TIMESTAMP",
              "constraint": "Auto",
              "description": "Waktu pembuatan"
            },
            {
              "name": "updated_at",
              "type": "TIMESTAMP",
              "constraint": "Auto",
              "description": "Waktu update"
            }
          ]
        },
