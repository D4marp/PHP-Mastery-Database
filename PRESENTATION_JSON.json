        "title": "Troubleshooting",
        "type": "content_slide",
        "content": {
          "issues": [
            {
              "problem": "Route not found (404)",
              "solution": "Check URL is /students, run php artisan route:list"
            },
            {
              "problem": "Database file not found",
              "solution": "Run php artisan migrate && php artisan db:seed"
            },
            {
              "problem": "CSRF token mismatch (419)",
              "solution": "Add @csrf in form, clear browser cache"
            },
            {
              "problem": "Form validation errors",
              "solution": "Fill all required fields, check email format"
            },
            {
              "problem": "500 Server Error",
              "solution": "Check logs, clear cache, restart server"
            }
          ]
        },
