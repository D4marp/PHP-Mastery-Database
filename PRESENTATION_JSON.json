        "title": "Database Schema",
        "type": "content_slide",
        "content": {
          "table": "students",
          "fields": [
            {
              "name": "id",
              "type": "INTEGER PRIMARY KEY",
              "constraint": "Auto increment",
              "description": "Identitas unik"
