      {
        "slide_number": 10,
        "title": "Code Example - Model",
        "type": "code_slide",
        "language": "php",
        "file": "app/Models/Student.php",
        "code": "<?php\nnamespace App\\Models;\nuse Illuminate\\Database\\Eloquent\\Model;\n\nclass Student extends Model\n{\n    protected $fillable = [\n        'nim',\n        'name',\n        'email',\n        'phone',\n        'address',\n        'major'\n    ];\n}",
        "notes": "Jelaskan mass assignment protection dengan $fillable"
      },
      {
        "slide_number": 11,
        "title": "Code Example - Controller Store",
        "type": "code_slide",
        "language": "php",
        "file": "app/Http/Controllers/StudentController.php",
        "code": "public function store(Request $request)\n{\n    $validated = $request->validate([\n        'nim' => 'required|unique:students',\n        'name' => 'required',\n        'email' => 'required|email|unique:students',\n        'phone' => 'required',\n        'address' => 'required',\n        'major' => 'required'\n    ]);\n\n    Student::create($validated);\n    return redirect()->route('students.index')\n        ->with('success', 'Student created successfully');\n}",
        "notes": "Jelaskan validation rules dan data creation"
      },
      {
        "slide_number": 12,
        "title": "Code Example - Blade Template",
        "type": "code_slide",
        "language": "html",
        "file": "resources/views/students/index.blade.php",
        "code": "@foreach($students as $student)\n    <tr>\n        <td>{{ $student->nim }}</td>\n        <td>{{ $student->name }}</td>\n        <td>{{ $student->email }}</td>\n        <td>{{ $student->phone }}</td>\n        <td>{{ $student->major }}</td>\n        <td>\n            <a href=\"{{ route('students.show', $student->id) }}\">View</a>\n            <a href=\"{{ route('students.edit', $student->id) }}\">Edit</a>\n            <form action=\"{{ route('students.destroy', $student->id) }}\" method=\"POST\">\n                @csrf @method('DELETE')\n                <button type=\"submit\">Delete</button>\n            </form>\n        </td>\n    </tr>\n@endforeach",
        "notes": "Jelaskan Blade syntax dan looping"
      },
